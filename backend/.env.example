# Copia este archivo como .env y completa los valores.

# Supabase → Project Settings → Database → Connection string → URI
# Usa el "Session pooler" (puerto 5432); el "Transaction pooler" (6543) también funciona.
DATABASE_URL=postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

DB_POOL_MIN=1
DB_POOL_MAX=10

# Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=cambia-este-valor-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRA_MINUTOS=480

# Un producto se marca con "stock bajo" cuando su stock es menor o igual a este valor
STOCK_MINIMO=5
